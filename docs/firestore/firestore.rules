rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn();
      // Client registration may create only non-admin accounts. Admin roles
      // are provisioned out of band; owners cannot promote themselves.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['user', 'worker'];
      allow update: if signedIn() && (isAdmin() || (request.auth.uid == uid
        && (request.resource.data.role == resource.data.role
          || (resource.data.role in ['user', 'worker'] && request.resource.data.role in ['user', 'worker']))));
      allow delete: if false;
    }

    function validVerificationSummary(data) {
      return data.keys().hasOnly(['status', 'submittedAt', 'reviewedAt'])
        && data.status in ['notStarted', 'pending', 'verified', 'rejected'];
    }
    function ownerVerificationSubmit(uid) {
      let proof = getAfter(/databases/$(database)/documents/workerVerifications/$(uid)).data;
      return request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verification', 'updatedAt'])
        && validVerificationSummary(request.resource.data.verification)
        && resource.data.get('verification', {}).get('status', 'notStarted') in ['notStarted', 'rejected']
        && request.resource.data.verification.status == 'pending'
        && request.resource.data.verification.submittedAt == request.time
        && proof.status == 'pending' && proof.submittedAt == request.time;
    }
    match /workers/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['verification', 'approved', 'blocked']));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verification', 'approved', 'blocked'])
          || ownerVerificationSubmit(uid)));
      allow delete: if false;
    }
    match /workerVerifications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      function submission() {
        let summary = getAfter(/databases/$(database)/documents/workers/$(uid)).data.verification;
        return request.resource.data.keys().hasOnly(['status', 'cnicFrontPath', 'cnicBackPath', 'selfiePath', 'submittedAt', 'consent', 'consentVersion'])
          && request.resource.data.status == 'pending'
          && request.resource.data.consent == true
          && request.resource.data.consentVersion == '2026-10-local-demo-v1'
          && request.resource.data.cnicFrontPath is string && request.resource.data.cnicFrontPath.size() > 0
          && request.resource.data.cnicBackPath is string && request.resource.data.cnicBackPath.size() > 0
          && request.resource.data.selfiePath is string && request.resource.data.selfiePath.size() > 0
          && request.resource.data.submittedAt == request.time
          && summary.status == 'pending' && summary.submittedAt == request.time;
      }
      allow create: if signedIn() && request.auth.uid == uid && submission();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && resource.data.get('status', 'notStarted') in ['notStarted', 'rejected'] && submission());
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    // No secrets: checked before sign-in. Missing/failed reads are fail-open.
    match /config/app {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /languages/{id} {
      // Readable unauthenticated too: the sign-up screen lists app
      // languages before an account exists.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /conversations/{convId} {
      allow read, write: if signedIn();
      match /messages/{msgId} {
        allow read, write: if signedIn();
      }
    }

    match /jobRequests/{id} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /reviews/{id} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /payments/{id} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /reports/{id} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
